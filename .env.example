# Backend environment variables
# Copy this file to .env and fill in your values

# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017/appcarc?replicaSet=rs0

# Express Server Port
PORT=3001

# CORS — orígenes permitidos, separados por coma. En producción no hace
# falta (todo se sirve desde el mismo gateway/dominio, same-origin) — esto
# es para dev servers locales. Si no se define, usa un default con los
# puertos locales conocidos (Vite de appCARC-web/superadmin, Expo web).
# CORS_ORIGINS=http://localhost:3002,http://localhost:3003

# Dominio público del backend, como lo ve Internet (Mercado Pago, navegador
# del socio). Con esquema y SIN barra final, ej. https://app.appclub.net.ar.
# Se usa para la notification_url del webhook de Mercado Pago y las
# back_urls /pago/exito|error|pendiente. Si falta, cae al host de Tailscale
# (solo dev/compatibilidad) y en producción se avisa al arrancar.
# En dev dejarla vacía o apuntarla a un túnel propio: MP no llega a localhost.
BACKEND_PUBLIC_URL=

# JWT Configuration
# Generate a secure secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_here

# Google Sheets Integration
# Get the spreadsheet ID from the URL: https://docs.google.com/spreadsheets/d/{ID}/edit
GOOGLE_SHEETS_SOCIOS_ID=your_google_sheet_id_here
GOOGLE_SHEETS_SOCIOS_SHEET_NAME=Ficha de Socios

# Backup de MongoDB a Google Drive (scripts/uploadBackupToDrive.js)
# ID de la carpeta de Drive compartida con el Service Account (Editor).
# Se obtiene de la URL: https://drive.google.com/drive/folders/{ID}
BACKUP_DRIVE_FOLDER_ID=
# Cantidad de backups a conservar en Drive (se borran los más viejos)
BACKUP_RETENTION_COUNT=30

# Club Configuration
DEFAULT_CLUB_ID=CARC

# Redis Configuration (optional, for token blacklist)
REDIS_URL=

# Google OAuth Configuration
# Setup Instructions:
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create OAuth 2.0 credentials (Web application)
# 3. Add authorized JavaScript origins: http://localhost:3000 (frontend URL)
# 4. Add authorized redirect URIs: http://localhost:3001/api/auth/google/callback
# 5. Copy the Client ID and Secret below
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# Instagram sync (novedades): usa la Instagram Graph API oficial (Instagram Login),
# no un env var — la config (igUserId, accessToken) se guarda en la colección
# InstagramConfig de Mongo, por club. Ver src/resources/novedades/models/InstagramConfig.js

# Secreto compartido para el webhook de Google Forms (Apps Script -> /api/forms-webhook)
# Generar con: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
FORMS_WEBHOOK_SECRET=

# Google Sheets export (por club): el spreadsheetId no es un env var, se guarda
# en Club.integraciones.sheets.spreadsheetId (colección clubs), editable desde
# el panel superadmin. El service account de google-credentials.json es compartido.

# Cloudflare Tunnel (servicio cloudflared del docker-compose, ver deploy/README.md)
# Token del túnel, se copia del dashboard de Cloudflare al crear el túnel.
# Solo va en el .env de la Raspi; no commitearlo nunca.
CLOUDFLARE_TUNNEL_TOKEN=

# mongo-express (docker-compose.yml): usuario y contraseña del basic auth.
# Obligatorias: sin ellas `docker compose` no arranca. Elegir una contraseña
# propia; no usar admin/admin.
ME_CONFIG_BASICAUTH_USERNAME=
ME_CONFIG_BASICAUTH_PASSWORD=
